{
  "name": "iptv",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run dev",
    "build": "turbo run build",
    "build:nodejs": "turbo run build --filter=@iptv/node-bridge",
    "watch": "turbo run watch",
    "test": "turbo run test",
    "test:watch": "npm run test:watch --workspace=@iptv/client",
    "typecheck": "turbo run typecheck",
    "ng": "npm run ng --workspace=@iptv/client --",
    "cap:sync": "npm run build && npm run cap:sync --workspace=@iptv/client",
    "cap:open": "npm run cap:open --workspace=@iptv/client"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
